---
import "../styles.css";
interface Props {
	title?: string;
}
const { title = "my-video" } = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title}</title>
</head>
<body>
	<slot />
	<script>
		import { startSessionMonitor } from "../lib/sessionMonitor";
		startSessionMonitor();
	</script>
</body>
</html>
