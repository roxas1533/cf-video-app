---
import { env } from "cloudflare:workers";
import VideoPlayer from "../../components/VideoPlayer.tsx";
import Layout from "../../layouts/Layout.astro";
import { getVideoById } from "../../lib/videos";

const id = Astro.params.id;
if (!id) return Astro.redirect("/");

const t0 = Date.now();
const video = await getVideoById(env.VIDEO_DB, id);
const dbTime = Date.now() - t0;
if (!video) return Astro.redirect("/");

Astro.response.headers.set("Server-Timing", `db;dur=${dbTime}`);
---
<Layout title={video.name}>
	<div class="container">
		<div class="header">
			<a href="/" class="btn-icon-circle">
				<span class="i-feather-chevron-left text-lg" />
			</a>
			<h1 class="text-2xl font-semibold">{video.name}</h1>
		</div>
		<VideoPlayer client:only="solid-js" videoId={id} videoName={video.name} />
	</div>
</Layout>
