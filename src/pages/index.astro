---
import svgUpload from "~icons/feather/upload?raw";
import VideoGrid from "../components/VideoGrid.tsx";
import Layout from "../layouts/Layout.astro";
---
<Layout>
	<div class="container">
		<div class="header">
			<h1>Videos</h1>
			<div class="header-actions">
				<a href="/upload" class="header-link" title="Upload">
					<Fragment set:html={svgUpload} />
				</a>
			</div>
		</div>
		<VideoGrid client:only="solid-js" />
	</div>
</Layout>
