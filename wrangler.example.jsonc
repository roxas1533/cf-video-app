{
	"name": "my-video",
	"compatibility_date": "2025-01-01",
	"r2_buckets": [
		{
			"binding": "VIDEO_BUCKET",
			"bucket_name": "my-video"
		}
	],
	"d1_databases": [
		{
			"binding": "VIDEO_DB",
			"database_name": "my-video",
			"database_id": "<YOUR_D1_DATABASE_ID>"
		}
	],
	"routes": [
		{
			"pattern": "your-app.example.com",
			"custom_domain": true
		}
	]
}
