{
  "rules": [
    {
      "allowed": {
        "origins": ["https://your-app.example.com"],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Range", "Content-Type"]
      },
      "exposed_headers": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag"],
      "max_age_seconds": 86400
    }
  ]
}
