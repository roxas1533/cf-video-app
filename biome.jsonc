{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.css",
      "*.ts",
      "*.jsonc",
      "*.mjs"
    ]
  },
  "overrides": [
    {
      "includes": ["worker-configuration.d.ts"],
      "linter": { "enabled": false }
    }
  ],
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
